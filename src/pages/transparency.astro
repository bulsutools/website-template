---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Transparency"
  description="This monthly report lists every donation in and every expense out for the project, with receipts. Template placeholder content."
>
  <Header />
  <main class="transparency-page">

    <header class="hero">
      <h1>Transparency report</h1>
      <p class="lede">
        TODO(template): this page is a sample ledger. Replace every figure,
        receipt and note below with your project's real monthly report, and
        update it each month.
      </p>
    </header>

    <section class="balance" aria-labelledby="current-balance">
      <h2 id="current-balance">Current balance</h2>
      <div class="summary">
        <div class="summary-item summary-net">
          <span class="summary-label">Owed to the maintainer, as of Month Year</span>
          <span class="summary-value">₱0.00</span>
        </div>
      </div>
      <p class="receipt-note">
        The project owes nothing. Every bill through Month Year is paid.
      </p>
    </section>

    <section class="month" aria-labelledby="sample-month">
      <h2 id="sample-month">Sample month</h2>

      <div class="summary">
        <div class="summary-item">
          <span class="summary-label">Income</span>
          <span class="summary-value">₱0.00</span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Expenses</span>
          <span class="summary-value">₱0.00</span>
        </div>
        <div class="summary-item summary-net">
          <span class="summary-label">Net</span>
          <span class="summary-value">₱0.00</span>
        </div>
      </div>

      <h3>Money in</h3>
      <ul class="ledger">
        <li>
          <div class="ledger-what">
            Donations through <a href="https://app.campus.tools/donate">/donate</a>, with dates and fees noted
          </div>
          <div class="ledger-amount">₱0.00</div>
        </li>
        <li class="ledger-total">
          <div class="ledger-what">Total in</div>
          <div class="ledger-amount">₱0.00</div>
        </li>
      </ul>

      <h3>Money out</h3>
      <ul class="ledger">
        <li>
          <div class="ledger-what">
            Hosting and tooling costs, each with a receipt link
            <span class="recur">recurring</span>
          </div>
          <div class="ledger-amount">₱0.00</div>
        </li>
        <li class="ledger-total">
          <div class="ledger-what">Total out</div>
          <div class="ledger-amount">₱0.00</div>
        </li>
      </ul>

      <h3>Liabilities</h3>
      <p class="ledger-intro">
        If any expense was paid personally, list what the project owes back here.
      </p>
      <ul class="ledger">
        <li class="ledger-total">
          <div class="ledger-what">Balance owed</div>
          <div class="ledger-amount">₱0.00</div>
        </li>
      </ul>

      <h3>Notes</h3>
      <p>
        TODO(template): explain currency conversion, payment timing, and any
        unusual items an editor or donor might ask about.
      </p>

      <h3>Updates</h3>
      <p>
        TODO(template): list grants, program acceptances, or milestones this
        month.
      </p>
    </section>

    <section class="donate-line">
      <p>
        If the project is useful to you, <a href="https://app.campus.tools/donate">a donation</a> covers
        next month's bill.
      </p>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  /* Hallmark · macrostructure: ledger document · theme: house (Raleway · maroon · light paper) · enrichment: receipt scans · tone: plain */
  .transparency-page {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: hsl(5 53% 32% / 0.08);
    border: 1px solid hsl(5 53% 32% / 0.25);
    text-decoration: none;
    color: hsl(5, 53%, 32%);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .back-link:hover {
    background: hsl(5 53% 32% / 0.14);
  }

  .hero {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.05;
    margin: 0;
  }

  .lede {
    margin: 0;
    max-width: 38rem;
    color: hsl(0, 0%, 28%);
    line-height: 1.6;
  }

  .lede a,
  .receipt-note a,
  .donate-line a,
  .ledger a {
    color: hsl(5, 53%, 32%);
    font-weight: 600;
  }

  .month {
    margin-bottom: 2.5rem;
  }

  .balance {
    margin-bottom: 2.5rem;
  }

  .balance .summary {
    grid-template-columns: minmax(0, 1fr);
  }

  h2 {
    font-size: 1.5rem;
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid hsl(5 53% 32% / 0.2);
  }

  h3 {
    font-size: 1.0625rem;
    margin: 1.75rem 0 0.625rem;
  }

  .summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(5 30% 88%);
    background: hsl(5 20% 98%);
  }

  .summary-net {
    border-color: hsl(5 53% 32% / 0.35);
  }

  .summary-label {
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
  }

  .summary-value {
    font-size: 1.375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ledger li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid hsl(5 30% 90%);
    line-height: 1.5;
  }

  .ledger-what {
    color: hsl(0, 0%, 20%);
  }

  .ledger-amount {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .ledger-total {
    border-bottom: none;
  }

  .ledger-month {
    font-weight: 700;
    font-size: 0.875rem;
    padding-top: 0.875rem;
  }

  .ledger-intro {
    margin: 0 0 0.375rem;
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
  }

  .recur {
    font-size: 0.8125rem;
    color: hsl(0, 0%, 42%);
  }

  .sublines {
    list-style: none;
    margin: 0.375rem 0 0;
    padding: 0;
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
  }

  .sublines li {
    display: block;
    border-bottom: none;
    padding: 0.125rem 0;
  }

  .ledger-total .ledger-what,
  .ledger-total .ledger-amount {
    font-weight: 700;
  }

  .receipts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .receipts figure {
    margin: 0;
  }

  .receipts img {
    width: 100%;
    height: auto;
    border: 1px solid hsl(5 30% 88%);
    border-radius: 0.5rem;
    background: white;
  }

  .receipts figcaption {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
  }

  .receipt-note {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
    line-height: 1.5;
  }

  .chart {
    margin: 1.25rem 0 0;
  }

  .chart svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .chart figcaption {
    font-size: 0.875rem;
    color: hsl(0, 0%, 35%);
    margin-bottom: 0.375rem;
  }

  .chart .tick {
    font-size: 11px;
    fill: hsl(0, 0%, 45%);
    font-family: inherit;
  }

  .chart .dlabel {
    font-size: 11px;
    font-weight: 600;
    fill: hsl(0, 0%, 25%);
    font-family: inherit;
  }

  .month p {
    margin: 0 0 0.75rem;
    color: hsl(0, 0%, 28%);
    line-height: 1.6;
  }

  .donate-line p {
    margin: 0;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid hsl(5 30% 88%);
    background: hsl(5 20% 98%);
    color: hsl(0, 0%, 28%);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .back-link:focus-visible,
  .ledger a:focus-visible,
  .receipts a:focus-visible,
  .donate-line a:focus-visible {
    outline: 2px solid hsl(5, 53%, 32%);
    outline-offset: 2px;
  }

  @media (max-width: 540px) {
    .summary,
    .receipts {
      grid-template-columns: minmax(0, 1fr);
    }

    .ledger li {
      flex-direction: column;
      gap: 0.125rem;
    }
  }
</style>
